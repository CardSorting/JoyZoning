    <StyleInclude Source="avares://Avalonia.Themes.Fluent/FluentTheme.axaml" />
    <StyleInclude Source="avares://SvcSystems.UI.Terminal/Styles/Colors.axaml" />
    <StyleInclude Source="avares://JoyZoning.App/Themes/OperationalTheme.axaml" />
  </Application.Styles>
</Application>
