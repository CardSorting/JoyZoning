<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JoyZoning.App.ViewModels"
             xmlns:views="using:JoyZoning.App.Views"
             xmlns:terminal="using:SvcSystems.UI.Terminal"
             x:Class="JoyZoning.App.Views.ExecutionViewportView"
             x:DataType="vm:ExecutionViewportViewModel">
  <Grid RowDefinitions="Auto,Auto,*" ColumnDefinitions="*,*">
    <views:SurfaceTipBar Grid.Row="0" Grid.ColumnSpan="2" x:Name="SurfaceTip" />
    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
      <TextBlock Classes="title" Text="Execution Viewport" FontSize="14" />
      <TextBlock Text="{Binding Objective}" />
      <TextBlock Classes="subtitle" Text="{Binding ActivePlan, StringFormat=Plan: {0}}" />
    </StackPanel>

    <TabControl Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" SelectedIndex="{Binding SelectedTabIndex}">
      <TabItem Header="DietCode output">
        <Grid ColumnDefinitions="*,*">
          <Border Grid.Column="0" Background="#0d1117" Padding="8" Margin="0,0,4,0" CornerRadius="4">
            <ScrollViewer>
              <TextBlock FontFamily="Consolas,Courier New,monospace" Text="{Binding TerminalOutput}" TextWrapping="Wrap" />
            </ScrollViewer>
          </Border>
          <StackPanel Grid.Column="1" Margin="4,0,0,0">
            <TextBlock Classes="subtitle" Text="STEPS" />
            <ScrollViewer MaxHeight="400">
              <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ExecutionStepViewModel">
                    <TextBlock>
                      <Run Text="{Binding Ordinal}" />
                      <Run Text=". " />
                      <Run Text="{Binding Label}" />
                      <Run Text=" [" />
                      <Run Text="{Binding Status}" />
                      <Run Text="]" />
                    </TextBlock>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </StackPanel>
        </Grid>
      </TabItem>

      <TabItem Header="Hermes TUI">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <Border Grid.Row="0" Classes="panel" Margin="0,0,0,8"
                  IsVisible="{Binding ShowReconnectBanner}">
            <StackPanel Spacing="8">
              <TextBlock FontWeight="SemiBold" Text="Connection lost" />
              <TextBlock Classes="subtitle" Text="The dashboard may have restarted. Refresh the session token and reconnect." TextWrapping="Wrap" />
              <Button Content="Reconnect TUI" Command="{Binding ReconnectTuiCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <Border Grid.Row="1" Classes="panel" Margin="0,0,0,8"
                  IsVisible="{Binding ShowConnectionCard}">
            <StackPanel Spacing="8">
              <TextBlock FontWeight="SemiBold" Text="Hermes TUI is not connected" />
              <TextBlock Classes="subtitle" Text="JoyZoning will start the Hermes dashboard, acquire the session token, and open the terminal." TextWrapping="Wrap" />
              <Button Content="Connect dashboard &amp; TUI" Command="{Binding ConnectDashboardAndTuiCommand}"
                      HorizontalAlignment="Left" />
            </StackPanel>
          </Border>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
            <Button Content="Connect" Command="{Binding ConnectPtyCommand}"
                    IsEnabled="{Binding !PtyConnected}" />
            <Button Content="Disconnect" Command="{Binding DisconnectPtyCommand}"
                    IsEnabled="{Binding PtyConnected}" />
            <TextBlock Classes="subtitle" Text="{Binding PtyStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <Border Grid.Row="3" Background="#0d2626" CornerRadius="4" ClipToBounds="True">
            <terminal:TerminalControl Model="{Binding HermesTerminal}" FontSize="13" />
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
