<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JoyZoning.App.ViewModels"
        x:Class="JoyZoning.App.Views.HermesConnectionWindow"
        x:Name="ConnectionRoot"
        x:DataType="vm:HermesConnectionViewModel"
        Title="Hermes Connection"
        Width="560" Height="600"
        WindowStartupLocation="CenterOwner">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="10">
      <TextBlock Classes="title" Text="Hermes Connection" FontSize="16" />
      <TextBlock Classes="subtitle" Text="{Binding StatusMessage}" TextWrapping="Wrap" />

      <Border Classes="panel">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="subtitle" Text="SETUP CHECKLIST" />
            <TextBlock Grid.Column="1" Classes="subtitle" Text="{Binding SetupProgress, StringFormat={}{0}%}" />
          </Grid>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding SetupProgress}" Height="6" />
          <ItemsControl ItemsSource="{Binding Checklist}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:OnboardingChecklistItemViewModel">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" Margin="0,0,6,0" />
                  <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                  <Button Grid.Column="2" Content="{Binding FixHint}" IsVisible="{Binding ShowFix}"
                          Command="{Binding DataContext.FixChecklistItemCommand, ElementName=ConnectionRoot}"
                          CommandParameter="{Binding Id}" Padding="8,2" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Content="Test full connection" Command="{Binding TestConnectionCommand}"
                  HorizontalAlignment="Left" IsEnabled="{Binding !IsBusy}" />
        </StackPanel>
      </Border>

      <TextBlock Classes="title" Text="1. Paths" FontSize="14" />
      <TextBlock Classes="subtitle" Text="Hermes install root" />
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBox Grid.Column="0" Text="{Binding InstallRoot}" />
        <Button Grid.Column="1" Content="Auto-detect" Command="{Binding AutoDetectInstallRootCommand}" Margin="8,0,0,0" />
        <Button Grid.Column="2" Name="BrowseInstallButton" Content="Browse…" Margin="8,0,0,0" />
      </Grid>
      <TextBlock Name="PathValidationText" Classes="subtitle" Text="{Binding PathValidationMessage}" TextWrapping="Wrap" />
      <TextBlock Classes="subtitle" Text="API base URL" />
      <TextBox Text="{Binding ApiBaseUrl}" />
      <TextBlock Classes="subtitle" Text="Dashboard base URL" />
      <TextBox Text="{Binding DashboardBaseUrl}" />
      <TextBlock Classes="subtitle" Text="Profile" />
      <TextBox Text="{Binding Profile}" />
      <Button Content="Save paths" Command="{Binding SavePathsCommand}" HorizontalAlignment="Left" />

      <TextBlock Classes="title" Text="2. Connect" FontSize="14" Margin="0,8,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Ensure gateway" Command="{Binding EnsureGatewayCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Content="Connect dashboard" Command="{Binding EnsureDashboardCommand}" IsEnabled="{Binding !IsBusy}" />
        <Button Content="Connect all" Command="{Binding ConnectAllCommand}" IsEnabled="{Binding !IsBusy}" />
      </StackPanel>
      <Button Content="Refresh token" Command="{Binding RefreshTokenCommand}"
              HorizontalAlignment="Left" IsEnabled="{Binding !IsBusy}" />

      <ItemsControl ItemsSource="{Binding Steps}" IsVisible="{Binding IsBusy}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ConnectionStepViewModel">
            <TextBlock Margin="0,2">
              <Run Text="{Binding StatusIcon}" />
              <Run Text=" " />
              <Run Text="{Binding Label}" />
              <Run Text=" — " />
              <Run Text="{Binding Detail}" />
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Expander Header="Advanced" IsExpanded="{Binding ShowAdvanced}">
        <StackPanel Spacing="8" Margin="0,8,0,0">
          <TextBlock Classes="subtitle" Text="Manual dashboard token (optional override)" />
          <TextBox Text="{Binding ManualToken}" PlaceholderText="X-Hermes-Session-Token" />
        </StackPanel>
      </Expander>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
        <Button Content="Refresh status" Command="{Binding RefreshStatusCommand}" />
        <Button Content="Close" Click="OnClose" IsDefault="True" />
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
