<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JoyZoning.App.ViewModels"
             x:Class="JoyZoning.App.Views.ApprovalsPanel"
             x:DataType="vm:ApprovalsViewModel">
  <DockPanel>
    <Button DockPanel.Dock="Top" Content="Refresh" Command="{Binding RefreshApprovalsCommand}" Margin="0,0,0,8" />
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Pending}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ApprovalCardViewModel">
            <Border Margin="0,4" Padding="8" Background="#21262d" CornerRadius="4">
              <StackPanel Spacing="4">
                <TextBlock FontWeight="Bold" Text="{Binding Risk, StringFormat=Risk: {0}}" />
                <TextBlock Text="{Binding Command}" TextWrapping="Wrap" FontFamily="Consolas,monospace" FontSize="11" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Classes="subtitle" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Content="Once" Command="{Binding ApproveOnceCommand}" Padding="6,2" />
                  <Button Content="Task" Command="{Binding ApproveForTaskCommand}" Padding="6,2" />
                  <Button Content="Session" Command="{Binding ApproveSessionCommand}" Padding="6,2" />
                  <Button Content="Deny" Command="{Binding DenyCommand}" Padding="6,2" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
