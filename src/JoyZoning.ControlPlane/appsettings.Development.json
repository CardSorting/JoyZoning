{
  "Workspace": {
    "MirrorToSessionRoot": true,
    "LiveMonitorIntervalSeconds": 3
  },
  "LeaseRuntime": {
    "ReconciliationIntervalSeconds": 20,
    "WorktreeMonitorIntervalSeconds": 3,
    "Stale": {
      "LeasedMinutes": 120,
      "RunningMinutes": 180,
      "VerifyingMinutes": 180
    }
  },
  "WorkspaceParallelism": {
    "DeferFullKanbanSyncWhenActiveLeasesAtLeast": 2,
    "KanbanOutboxPollIntervalMs": 250,
    "LiveMirrorMode": "PerExecution",
    "DisableSharedSessionRootMirrorWhenParallel": true,
    "LiveMirrorRetentionDays": 14
  },
  "Executor": {
    "StreamStatusPollIntervalSeconds": 1,
    "StreamStatusPollAttempts": 10,
    "MaxStreamResumeAttempts": 16
  }
}
