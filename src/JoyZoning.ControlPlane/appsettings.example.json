{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Hermes": {
    "InstallRoot": "/path/to/diet-hermes-main-master",
    "Profile": "joyzoning",
    "ApiBaseUrl": "http://127.0.0.1:8642",
    "DashboardBaseUrl": "http://127.0.0.1:9119",
    "AutoStartGateway": true
  },
  "ControlPlane": {
    "ListenUrl": "http://127.0.0.1:9470"
  },
  "BroccoliQ": {
    "Enabled": true,
    "AutoStartWorker": true,
    "SupervisorEnabled": true,
    "BridgeListenUrl": "http://127.0.0.1:9471",
    "DatabasePath": null,
    "RepoRoot": null,
    "EventMirrorTimeoutMs": 800,
    "WorkerStartupTimeoutSeconds": 20,
    "WorkerSupervisorIntervalSeconds": 30,
    "MirrorQueueCapacity": 8192,
    "MirrorBatchSize": 64,
    "MirrorFlushIntervalMs": 75,
    "MaxRequestBodyBytes": 1048576,
    "BackfillOnStartup": true,
    "BackfillMaxEvents": 5000,
    "BackfillTasksOnStartup": true,
    "MirrorPumpRetryAttempts": 3
  },
  "Executor": {
    "AutoApproveToolRequests": true
  },
  "Workspace": {
    "MirrorToSessionRoot": true,
    "LiveStatusFileName": "JOYZONING_LIVE.md"
  },
  "WorkspaceParallelism": {
    "LiveMirrorMode": "PerExecution",
    "DisableSharedSessionRootMirrorWhenParallel": true,
    "LiveMirrorRetentionDays": 14
  },
  "LeaseRuntime": {
    "MaxGlobalActiveLeases": 16,
    "MaxActiveLeasesPerSession": 8,
    "MaxCriticalLeases": 1,
    "ReconciliationIntervalSeconds": 60,
    "WorktreeMonitorEnabled": true,
    "WorktreeMonitorIntervalSeconds": 45,
    "AbsoluteExpirationRevokes": false,
    "Duration": {
      "LowHours": 8,
      "MediumHours": 4,
      "CriticalHours": 2
    },
    "Stale": {
      "LeasedMinutes": 30,
      "RunningMinutes": 45,
      "VerifyingMinutes": 90,
      "CriticalLeasedMinutes": 10,
      "CriticalRunningMinutes": 20,
      "CriticalVerifyingMinutes": 45
    }
  }
}
