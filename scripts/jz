#!/usr/bin/env bash
# JoyZoning CLI — terminal automation against the control plane REST API.
# Usage: ./scripts/jz health
# Install: ./scripts/install-jz.sh  (adds ~/.local/bin/jz)

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
PROJECT="$ROOT/src/JoyZoning.Cli/JoyZoning.Cli.csproj"

if [[ -n "${JOYZONING_CLI_BIN:-}" && -x "${JOYZONING_CLI_BIN}" ]]; then
  exec "${JOYZONING_CLI_BIN}" "$@"
fi

export DOTNET_ROOT="${DOTNET_ROOT:-$HOME/.dotnet}"
export PATH="${DOTNET_ROOT}:${PATH}"

# Prefer repo publish output over a stale ~/.local install when developing.
if [[ -x "$ROOT/dist/jz-publish/jz" ]]; then
  exec "$ROOT/dist/jz-publish/jz" "$@"
fi

if [[ -x "${HOME}/.local/bin/joyzoning-jz/jz" ]]; then
  exec "${HOME}/.local/bin/joyzoning-jz/jz" "$@"
fi

exec dotnet run --project "$PROJECT" -- "$@"
